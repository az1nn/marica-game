{
  "schema_version": 1,
  "catalog": "SPEC-004 G416 Luau to Godot golden contracts",
  "contracts": [
    {
      "id": "harness.deep_equal",
      "status": "ACTIVE_SELFTEST",
      "milestone": "G416",
      "source": "game/tests/golden_fixture_runner.gd",
      "cases": [
        {
          "id": "nested-equal",
          "invariant": "structural comparison of deterministic nested state",
          "input": {
            "left": {
              "pet": "p-1",
              "traits": [
                0.5,
                0.75
              ],
              "status": {
                "active": true
              }
            },
            "right": {
              "status": {
                "active": true
              },
              "traits": [
                0.5,
                0.75
              ],
              "pet": "p-1"
            }
          },
          "expected": {
            "equal": true
          }
        },
        {
          "id": "nested-different",
          "invariant": "negative guard detects a changed nested result",
          "input": {
            "left": {
              "pet": "p-1",
              "traits": [
                0.5,
                0.75
              ]
            },
            "right": {
              "pet": "p-1",
              "traits": [
                0.5,
                0.7
              ]
            }
          },
          "expected": {
            "equal": false
          }
        },
        {
          "id": "array-order-matters",
          "invariant": "fixture matching preserves sequence order",
          "input": {
            "left": [
              "a",
              "b"
            ],
            "right": [
              "b",
              "a"
            ]
          },
          "expected": {
            "equal": false
          }
        },
        {
          "id": "identical-scalar",
          "invariant": "fixture matching accepts identical scalar",
          "input": {
            "left": "lineage-1",
            "right": "lineage-1"
          },
          "expected": {
            "equal": true
          }
        }
      ]
    },
    {
      "id": "pet_id.from_string",
      "status": "ACTIVE_PARITY",
      "milestone": "G420",
      "source": "src/shared/domain/PetId.luau",
      "cases": [
        {
          "id": "pet-id-valid",
          "invariant": "pet IDs are validated without mutation",
          "input": {
            "value": "pet-001"
          },
          "expected": {
            "id": "pet-001"
          }
        },
        {
          "id": "pet-id-whitespace",
          "invariant": "whitespace-only IDs rejected",
          "input": {
            "value": " \t "
          },
          "expected_error": "PetId must not be empty"
        },
        {
          "id": "pet-id-empty",
          "invariant": "empty Pet IDs are rejected exactly",
          "input": {
            "value": ""
          },
          "expected_error": "PetId must not be empty"
        },
        {
          "id": "pet-id-non-string",
          "invariant": "non-string Pet IDs are rejected exactly",
          "input": {
            "value": 42
          },
          "expected_error": "PetId must be a string"
        },
        {
          "id": "pet-id-preserve-valid-whitespace",
          "invariant": "valid nonblank input is returned without normalization",
          "input": {
            "value": " pet-002 "
          },
          "expected": {
            "id": " pet-002 "
          }
        }
      ],
      "adapter": "game/src/domain/pet_id.gd"
    },
    {
      "id": "lineage_id.from_string",
      "status": "ACTIVE_PARITY",
      "milestone": "G421",
      "source": "src/shared/domain/LineageId.luau",
      "cases": [
        {
          "id": "lineage-valid",
          "invariant": "lineage IDs are validated without mutation",
          "input": {
            "value": "lineage-001"
          },
          "expected": {
            "id": "lineage-001"
          }
        },
        {
          "id": "lineage-empty",
          "invariant": "empty lineage IDs rejected",
          "input": {
            "value": ""
          },
          "expected_error": "LineageId must not be empty"
        },
        {
          "id": "lineage-whitespace-only",
          "invariant": "whitespace-only lineage IDs rejected",
          "input": {
            "value": " \t "
          },
          "expected_error": "LineageId must not be empty"
        },
        {
          "id": "lineage-non-string",
          "invariant": "number cannot become lineage identity",
          "input": {
            "value": 42
          },
          "expected_error": "LineageId must be a string"
        },
        {
          "id": "lineage-preserve-whitespace",
          "invariant": "nonblank IDs preserved verbatim",
          "input": {
            "value": " lin-2 "
          },
          "expected": {
            "id": " lin-2 "
          }
        },
        {
          "id": "lineage-reject-null",
          "invariant": "null is not a string",
          "input": {
            "value": null
          },
          "expected_error": "LineageId must be a string"
        }
      ],
      "adapter": "game/src/domain/lineage_id.gd"
    },
    {
      "id": "pedigree.create",
      "status": "ACTIVE_PARITY",
      "milestone": "G421",
      "source": "src/shared/domain/Pedigree.luau",
      "adapter": "game/src/domain/pedigree.gd",
      "cases": [
        {
          "id": "founder-default",
          "invariant": "founder has zero parents and generation zero",
          "input": {
            "lineageId": "lineage-001",
            "generation": 0,
            "founderPetId": "pet-founder-001"
          },
          "expected": {
            "lineageId": "lineage-001",
            "generation": 0,
            "founderPetId": "pet-founder-001",
            "parentPetIds": []
          }
        },
        {
          "id": "founder-explicit",
          "invariant": "explicit empty parents stay empty",
          "input": {
            "lineageId": "lineage-001",
            "generation": 0,
            "founderPetId": "pet-founder-001",
            "parentPetIds": []
          },
          "expected": {
            "lineageId": "lineage-001",
            "generation": 0,
            "founderPetId": "pet-founder-001",
            "parentPetIds": []
          }
        },
        {
          "id": "child-one-parent",
          "invariant": "direct parent IDs and founder ID are retained",
          "input": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-founder-001"
            ]
          },
          "expected": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-founder-001"
            ]
          }
        },
        {
          "id": "child-two-parents",
          "invariant": "at most two parents; order retained",
          "input": {
            "lineageId": "lineage-001",
            "generation": 2,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-p1",
              "pet-p2"
            ]
          },
          "expected": {
            "lineageId": "lineage-001",
            "generation": 2,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-p1",
              "pet-p2"
            ]
          }
        },
        {
          "id": "generation-negative",
          "invariant": "negative generation rejected",
          "input": {
            "lineageId": "lineage-001",
            "generation": -1,
            "founderPetId": "pet-founder-001"
          },
          "expected_error": "Pedigree generation must be a non-negative integer"
        },
        {
          "id": "generation-fractional",
          "invariant": "fractional generation rejected",
          "input": {
            "lineageId": "lineage-001",
            "generation": 0.5,
            "founderPetId": "pet-founder-001"
          },
          "expected_error": "Pedigree generation must be a non-negative integer"
        },
        {
          "id": "generation-string",
          "invariant": "non-numeric generation rejected",
          "input": {
            "lineageId": "lineage-001",
            "generation": "1",
            "founderPetId": "pet-founder-001"
          },
          "expected_error": "Pedigree generation must be a non-negative integer"
        },
        {
          "id": "founder-with-parent",
          "invariant": "founder must not have parents",
          "input": {
            "lineageId": "lineage-001",
            "generation": 0,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-other"
            ]
          },
          "expected_error": "Generation zero pedigree must not have parents"
        },
        {
          "id": "descendant-no-parent",
          "invariant": "non-founder must have direct parent",
          "input": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001"
          },
          "expected_error": "Descendant pedigree must have at least one direct parent"
        },
        {
          "id": "duplicate-parents",
          "invariant": "same direct parent cannot repeat",
          "input": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-p",
              "pet-p"
            ]
          },
          "expected_error": "Pedigree parent ids must be unique"
        },
        {
          "id": "more-than-two-parents",
          "invariant": "at most two distinct direct parents",
          "input": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              "pet-a",
              "pet-b",
              "pet-c"
            ]
          },
          "expected_error": "Pedigree supports at most two direct parents"
        },
        {
          "id": "invalid-lineage",
          "invariant": "lineage validation precedes structure checks",
          "input": {
            "lineageId": " \t ",
            "generation": 0,
            "founderPetId": "pet-founder-001"
          },
          "expected_error": "LineageId must not be empty"
        },
        {
          "id": "invalid-founder",
          "invariant": "founder ID validated",
          "input": {
            "lineageId": "lineage-001",
            "generation": 0,
            "founderPetId": ""
          },
          "expected_error": "PetId must not be empty"
        },
        {
          "id": "invalid-parent-id",
          "invariant": "each direct parent ID validated",
          "input": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001",
            "parentPetIds": [
              " "
            ]
          },
          "expected_error": "PetId must not be empty"
        },
        {
          "id": "invalid-parent-type",
          "invariant": "direct parents must be an array",
          "input": {
            "lineageId": "lineage-001",
            "generation": 1,
            "founderPetId": "pet-founder-001",
            "parentPetIds": "pet-parent"
          },
          "expected_error": "Pedigree parent ids must be an array"
        }
      ]
    },
    {
      "id": "lifecycle.transitions",
      "status": "ACTIVE_PARITY",
      "milestone": "G422",
      "source": "src/shared/domain/Lifecycle.luau",
      "adapter": "game/src/domain/lifecycle.gd",
      "cases": [
        {
          "id": "new-juvenile",
          "invariant": "new lifecycle starts as active juvenile",
          "input": {
            "actions": []
          },
          "expected": {
            "stage": "juvenile",
            "status": "active",
            "terminal": false
          }
        },
        {
          "id": "juvenile-to-adult",
          "invariant": "first stage transition is exactly one step",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              }
            ]
          },
          "expected": {
            "stage": "adult",
            "status": "active",
            "terminal": false
          }
        },
        {
          "id": "adult-to-senior",
          "invariant": "two adjacent advances preserve order",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "advance",
                "stage": "senior"
              }
            ]
          },
          "expected": {
            "stage": "senior",
            "status": "active",
            "terminal": false
          }
        },
        {
          "id": "health-juvenile",
          "invariant": "health end may occur in juvenile stage",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": "health"
              }
            ]
          },
          "expected": {
            "stage": "juvenile",
            "status": "ended",
            "endReason": "health",
            "terminal": true
          }
        },
        {
          "id": "health-adult",
          "invariant": "health end may occur after maturation",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "endLife",
                "reason": "health"
              }
            ]
          },
          "expected": {
            "stage": "adult",
            "status": "ended",
            "endReason": "health",
            "terminal": true
          }
        },
        {
          "id": "health-senior",
          "invariant": "health end is also possible at senior",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "advance",
                "stage": "senior"
              },
              {
                "op": "endLife",
                "reason": "health"
              }
            ]
          },
          "expected": {
            "stage": "senior",
            "status": "ended",
            "endReason": "health",
            "terminal": true
          }
        },
        {
          "id": "natural-senior",
          "invariant": "natural ending is allowed only for senior",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "advance",
                "stage": "senior"
              },
              {
                "op": "endLife",
                "reason": "natural"
              }
            ]
          },
          "expected": {
            "stage": "senior",
            "status": "ended",
            "endReason": "natural",
            "terminal": true
          }
        },
        {
          "id": "reject-skip",
          "invariant": "cannot skip juvenile to senior",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "senior"
              }
            ]
          },
          "expected_error": "Lifecycle stages must advance exactly one step"
        },
        {
          "id": "reject-backwards",
          "invariant": "cannot advance adult backwards",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "advance",
                "stage": "juvenile"
              }
            ]
          },
          "expected_error": "Lifecycle stages must advance exactly one step"
        },
        {
          "id": "reject-repeated",
          "invariant": "cannot advance adult to adult",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "advance",
                "stage": "adult"
              }
            ]
          },
          "expected_error": "Lifecycle stages must advance exactly one step"
        },
        {
          "id": "reject-natural-juvenile",
          "invariant": "juvenile cannot die naturally",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": "natural"
              }
            ]
          },
          "expected_error": "Natural end of life requires senior stage"
        },
        {
          "id": "reject-natural-adult",
          "invariant": "adult cannot die naturally",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "adult"
              },
              {
                "op": "endLife",
                "reason": "natural"
              }
            ]
          },
          "expected_error": "Natural end of life requires senior stage"
        },
        {
          "id": "reject-stage-name",
          "invariant": "only three lifecycle stages permitted",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": "elder"
              }
            ]
          },
          "expected_error": "Lifecycle stage is invalid"
        },
        {
          "id": "reject-stage-nonstring",
          "invariant": "stage must be a string",
          "input": {
            "actions": [
              {
                "op": "advance",
                "stage": 12
              }
            ]
          },
          "expected_error": "Lifecycle stage is invalid"
        },
        {
          "id": "reject-end-reason",
          "invariant": "end reason is limited to natural or health",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": "unknown"
              }
            ]
          },
          "expected_error": "Lifecycle end reason is invalid"
        },
        {
          "id": "reject-end-reason-number",
          "invariant": "end reason must not be a number",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": 100
              }
            ]
          },
          "expected_error": "Lifecycle end reason is invalid"
        },
        {
          "id": "reject-advance-after-end",
          "invariant": "ended lifecycle never advances",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": "health"
              },
              {
                "op": "advance",
                "stage": "adult"
              }
            ]
          },
          "expected_error": "Ended lifecycle cannot advance"
        },
        {
          "id": "reject-reend-after-end",
          "invariant": "ended lifecycle never ends twice",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": "health"
              },
              {
                "op": "endLife",
                "reason": "health"
              }
            ]
          },
          "expected_error": "Ended lifecycle is terminal"
        },
        {
          "id": "reject-change-end-reason",
          "invariant": "ended lifecycle cannot change termination reason",
          "input": {
            "actions": [
              {
                "op": "endLife",
                "reason": "health"
              },
              {
                "op": "endLife",
                "reason": "natural"
              }
            ]
          },
          "expected_error": "Ended lifecycle is terminal"
        }
      ]
    },
    {
      "id": "simulation_time.observe",
      "status": "ACTIVE_PARITY",
      "milestone": "G423",
      "source": "src/shared/domain/SimulationTime.luau",
      "cases": [
        {
          "id": "clock-forward",
          "invariant": "elapsed time derives from injected clock",
          "input": {
            "lastObservedAt": 100,
            "clockNow": 112
          },
          "expected": {
            "rawNow": 112,
            "logicalNow": 112,
            "elapsed": 12
          }
        },
        {
          "id": "clock-rollback",
          "invariant": "clock rollback never rewinds logical time",
          "input": {
            "lastObservedAt": 112,
            "clockNow": 95
          },
          "expected": {
            "rawNow": 95,
            "logicalNow": 112,
            "elapsed": 0
          }
        },
        {
          "id": "clock-invalid-negative",
          "invariant": "negative timestamps rejected",
          "input": {
            "lastObservedAt": 100,
            "clockNow": -1
          },
          "expected_error": "Clock.now() must not be negative"
        },
        {
          "id": "clock-forward-fractional",
          "invariant": "fractional elapsed time is deterministic",
          "input": {
            "lastObservedAt": 100.25,
            "clockNow": 101.75
          },
          "expected": {
            "rawNow": 101.75,
            "logicalNow": 101.75,
            "elapsed": 1.5
          }
        },
        {
          "id": "clock-equal",
          "invariant": "equal observations yield zero elapsed",
          "input": {
            "lastObservedAt": 112,
            "clockNow": 112
          },
          "expected": {
            "rawNow": 112,
            "logicalNow": 112,
            "elapsed": 0
          }
        },
        {
          "id": "clock-zero",
          "invariant": "zero timestamp remains valid",
          "input": {
            "lastObservedAt": 0,
            "clockNow": 0
          },
          "expected": {
            "rawNow": 0,
            "logicalNow": 0,
            "elapsed": 0
          }
        },
        {
          "id": "previous-invalid-negative",
          "invariant": "negative previous observed time rejected",
          "input": {
            "lastObservedAt": -1,
            "clockNow": 100
          },
          "expected_error": "lastObservedAt must not be negative"
        },
        {
          "id": "clock-invalid-string",
          "invariant": "non-numeric clock cannot be coerced into time",
          "input": {
            "lastObservedAt": 0,
            "clockNow": "not-a-time"
          },
          "expected_error": "Clock.now() must be a finite number"
        },
        {
          "id": "previous-invalid-string",
          "invariant": "non-numeric previous time rejected",
          "input": {
            "lastObservedAt": "not-a-time",
            "clockNow": 100
          },
          "expected_error": "lastObservedAt must be a finite number"
        }
      ],
      "adapter": "game/src/domain/simulation_time.gd"
    },
    {
      "id": "genetics.advance_potential",
      "status": "PENDING_PORT",
      "milestone": "G430",
      "source": "docs/migration/ROBLOX-TO-GODOT-CONTRACT-MAP.md",
      "cases": [
        {
          "id": "first-sorted-trait",
          "invariant": "seed zero selects lexicographically first trait",
          "input": {
            "potential": {
              "resilience": 0.4,
              "size": 0.5
            },
            "seed": 0
          },
          "expected": {
            "potential": {
              "resilience": 0.45,
              "size": 0.5
            }
          }
        },
        {
          "id": "saturated-fallback",
          "invariant": "saturated trait is skipped cyclically",
          "input": {
            "potential": {
              "resilience": 1,
              "size": 0.5
            },
            "seed": 0
          },
          "expected": {
            "potential": {
              "resilience": 1,
              "size": 0.55
            }
          }
        },
        {
          "id": "invalid-fractional-seed",
          "invariant": "fractional seed rejected",
          "input": {
            "potential": {
              "resilience": 0.4
            },
            "seed": 0.5
          },
          "expected_error": "invalid genetic seed"
        }
      ]
    }
  ]
}
